{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV", "APP_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**", "lib/**", ".next/**"],
      "env": [
        "NEXT_PUBLIC_APP_BASE_URL",
        "NEXT_PUBLIC_APP_SERVER_URL",
        "VITE_APP_BASE_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    },
    "format:file": {
      "cache": false
    },
    "pre:push": {
      "cache": false
    },
    "check-types": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "auth:generate": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:migrate-neon": {
      "cache": false
    },
    "expo:fix": {
      "cache": false
    }
  },
  "remoteCache": {
    "enabled": true
  }
}
