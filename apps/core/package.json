    "@shared/rpc": "workspace:*",
    "@shared/web-ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "better-auth": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "babel-plugin-react-compiler": "catalog:dev",
    "dotenv-cli": "catalog:dev",
    "pino-pretty": "catalog:dev",
    "tailwindcss": "catalog:dev",
    "typescript": "catalog:dev"
  }
