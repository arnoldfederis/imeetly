{
  "name": "core",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev -p 3001",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start",
    "lint": "bunx biome lint",
    "format": "bunx biome check --write --unsafe",
    "format:file": "bunx biome format --write",
    "pre:push": "bunx next typegen && bun lint && bun format",
    "clean": "rm -rf .next node_modules"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/experimental-pino": "catalog:",
    "@orpc/server": "catalog:",
