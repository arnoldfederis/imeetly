{
  "name": "@repo/server",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- bun run --hot src/index.ts",
    "build": "bun build --compile --target=bun --minify-whitespace --minify-syntax --outfile dist/server ./src/index.ts",
    "start": "./dist/server",
    "lint": "bunx biome lint",
    "format": "bunx biome check --write --unsafe",
    "format:file": "bunx biome format --write",
    "pre:push": "bun lint && bun format",
    "auth:generate": "dotenv -e ../../.env -- bunx @better-auth/cli generate --config=./src/lib/auth.ts -y",
    "check-types": "bunx tsc --noEmit",
    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1016.0",
    "@aws-sdk/s3-request-presigner": "^3.1016.0",
    "@better-auth/passkey": "catalog:",
    "@bogeychan/elysia-logger": "latest",
    "@elysiajs/cors": "latest",
    "@orpc/server": "catalog:",
    "@polar-sh/better-auth": "latest",
    "@polar-sh/sdk": "0.46.6",
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "@temporalio/client": "^1.15.0",
    "reflect-metadata": "^0.2.2",
    "better-auth": "catalog:",
    "better-auth-harmony": "1.3.1",
    "drizzle-orm": "catalog:",
    "elysia": "latest",
    "mailchecker": "catalog:",
    "nodemailer": "8.0.4",
    "pino": "catalog:",
    "resend": "latest",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:dev",
    "@types/nodemailer": "latest",
    "dotenv-cli": "catalog:dev",
    "pino-pretty": "catalog:dev"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./types": "./src/types.ts",
    "./router": "./src/router.ts",
    "./lib/*": "./src/lib/*",
    "./modules/action-item/*": "./src/modules/action-item/*",
    "./modules/admin/*": "./src/modules/admin/*",
    "./modules/auth/*": "./src/modules/auth/*",
    "./modules/billing/*": "./src/modules/billing/*",
    "./modules/health/*": "./src/modules/health/*",
    "./modules/meeting/*": "./src/modules/meeting/*",
    "./modules/user/*": "./src/modules/user/*",
    "./lib/temporal": "./src/lib/temporal.ts",
    "./modules/*/model": "./src/modules/*/model.ts",
    "./procedure": "./src/procedure.ts"
  }
}
