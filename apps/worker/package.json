{
  "name": "@repo/worker",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/worker.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node -r tsconfig-paths/register lib/worker.js",
    "lint": "bunx biome lint",
    "format": "bunx biome check --write --unsafe",
    "format:file": "bunx biome format --write",
    "pre:push": "bun lint && bun format",
    "check-types": "bunx tsc --project tsconfig.check.json",
    "clean": "rm -rf node_modules lib"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "ts-node"
    },
    "ext": "ts",
    "watch": [
      "src"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@aws-sdk/client-s3": "^3.1016.0",
    "@neondatabase/serverless": "^1.0.0",
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "@t3-oss/env-core": "0.13.11",
    "@temporalio/activity": "^1.15.0",
    "@temporalio/envconfig": "^1.15.0",
    "@temporalio/worker": "^1.15.0",
    "@temporalio/workflow": "^1.15.0",
    "drizzle-orm": "catalog:",
    "groq-sdk": "^1.1.1",
    "nanoid": "^5.1.6",
    "openai": "^6.31.0",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "catalog:dev",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
