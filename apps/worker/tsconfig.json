{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": "./",
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "paths": {
      "@repo/worker/*": ["./src/*"],
      "@repo/db/schemas/*": ["../../packages/db/src/schemas/*"],
      "@repo/db/relations/*": ["../../packages/db/src/relations/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
