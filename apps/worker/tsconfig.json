{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./lib",
    "baseUrl": "./",
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@repo/worker/*": ["./src/*"],
      "@repo/db/schemas/*": ["../../packages/db/src/schemas/*"],
      "@repo/db/relations/*": ["../../packages/db/src/relations/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
